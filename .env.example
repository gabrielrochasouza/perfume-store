# ============================================================
# PERFUME STORE - Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha com seus dados
# ============================================================

# --- Loja ---
NEXT_PUBLIC_STORE_NAME=Perfume Store
NEXT_PUBLIC_STORE_SLOGAN=Fragrâncias que marcam presença

# --- WhatsApp (número do proprietário, sem + ou espaços) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999

# --- Chave PIX (padrão: telefone com +55, pode ser CPF, e-mail ou chave aleatória) ---
# NEXT_PUBLIC_PIX_KEY=+5511999999999

# --- Contato ---
NEXT_PUBLIC_STORE_EMAIL=contato@perfumestore.com
NEXT_PUBLIC_STORE_PHONE=(11) 99999-9999

# --- Endereço físico ---
NEXT_PUBLIC_STORE_ADDRESS=Rua das Fragrâncias, 123 - Centro
NEXT_PUBLIC_STORE_CITY=São Paulo
NEXT_PUBLIC_STORE_STATE=SP
NEXT_PUBLIC_STORE_CEP=01310-100

# --- Horário de funcionamento ---
NEXT_PUBLIC_BUSINESS_HOURS=Seg–Sex: 9h–18h | Sáb: 9h–13h

# --- Redes sociais (apenas o handle, sem @) ---
NEXT_PUBLIC_INSTAGRAM=perfumestore
NEXT_PUBLIC_FACEBOOK=perfumestore
NEXT_PUBLIC_TIKTOK=perfumestore

# --- Ano de fundação (rodapé) ---
NEXT_PUBLIC_FOUNDED_YEAR=2024
